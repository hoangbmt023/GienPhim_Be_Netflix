generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AnnouncementType {
  INFO      // Thông tin chung
  WARNING   // Cảnh báo nội dung
  DANGER    // Nghiêm trọng (bảo trì, cảnh báo API)
  SUCCESS   // Thông báo tích cực (event, sinh nhật)
}

enum AnnouncementDisplay {
  BAR   // Dải chạy marquee bên trên
  BOX   // Popup box overlay
}

enum AnnouncementScope {
  SYSTEM     // Chỉ ADMIN (bảo trì, cảnh báo API)
  CONTENT    // ADMIN + MODERATOR (cảnh báo nội dung)
  MARKETING  // ADMIN + MODERATOR (event, sự kiện)
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  password             String
  role                 Role            @default(USER)
  status               UserStatus      @default(PENDING)
  isDeleted            Boolean         @default(false)
  profiles             Profile[]
  refreshTokens        RefreshToken[]
  contactTickets       ContactTicket[]
  createdAnnouncements Announcement[]  @relation("AnnouncementCreator")
  updatedAnnouncements Announcement[]  @relation("AnnouncementUpdater")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Profile {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  avatar            String?
  pin               String?  // Optional PIN for profile lock
  isDeleted         Boolean  @default(false)
  // Notification mute settings
  notifMuteDays     Int      @default(1)   // 1, 3, 7, 15, 30 days; 0 = forever
  notifMutedForever Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations to histories and lists
  histories History[]
  favorites Favorite[]

  @@index([userId, isDeleted])
}

model Movie {
  id                String   @id @default(uuid())
  slug              String   @unique

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  histories         History[]
  favorites         Favorite[]

  @@index([createdAt])
}

model History {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episode   String?  // Which episode name
  episodeSlug String? // Which episode slug
  server    Int?     // Which server index (0, 1, 2...)
  timePos   Int?     // Time watched in seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, movieId])
  @@index([profileId, updatedAt])
}

model Favorite {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, movieId])
  @@index([profileId, createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiryDate DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum ContactStatus {
  OPEN        // Mới gửi, chưa xử lý
  IN_PROGRESS // Moderator đang xem xét
  REPLIED     // Đã phản hồi người dùng
  CLOSED      // Đóng ticket
}

model ContactTicket {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  subject     String
  message     String        @db.Text
  status      ContactStatus @default(OPEN)
  reply       String?       @db.Text  // Nội dung phản hồi từ Moderator
  repliedById String?                 // ID của Moderator đã phản hồi
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// ── Announcement ────────────────────────────────────────
model Announcement {
  id          String              @id @default(uuid())
  title       String              // Tên nội bộ để quản lý
  badge       String              // Text trên badge VD: "THÔNG BÁO"
  text        String              @db.Text
  link        String?             // URL nếu có nút "Xem ngay"
  type        AnnouncementType    @default(INFO)
  display     AnnouncementDisplay @default(BAR)
  scope       AnnouncementScope   @default(MARKETING)
  isActive    Boolean             @default(false) // Publish/Unpublish
  isDeleted   Boolean             @default(false) // Soft delete
  deletedAt   DateTime?           // Thời điểm xóa mềm
  startAt     DateTime?           // Ngày bắt đầu hiển thị (null = hiển thị ngay)
  endAt       DateTime?           // Ngày kết thúc hiển thị (null = vĩnh viễn)
  createdById String
  createdBy   User                @relation("AnnouncementCreator", fields: [createdById], references: [id])
  updatedById String?             // ID người sửa sau cùng
  updatedBy   User?               @relation("AnnouncementUpdater", fields: [updatedById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, startAt, endAt]) // Optimize query lấy thông báo active
  @@index([isDeleted])
  @@index([scope, isActive])
  @@index([createdById])
}
